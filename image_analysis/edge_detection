import numpy as np
import matplotlib.pyplot as plt
import cv2

image = cv2.imread('image.jpg')
""" Sobel edge detection """
sobelx = cv2.Sobel(image, cv2.CV_64F, 1, 0, ksize=3)
sobely = cv2.Sobel(image, cv2.CV_64F, 0, 1, ksize=3)
cv2.imshow('Sobel X', sobelx)
cv2.imshow('Sobel Y', sobely)
cv2.waitKey(0)
cv2.destroyAllWindows()

""" Prewitt edge detection """
kernelx = np.array([[ -1, 0, 1],[ -1, 0, 1],[ -1, 0, 1]])
kernely = np.array([[ -1, -1, -1],[ 0, 0, 0],[ 1, 1, 1]])
prewittx = cv2.filter2D(image, -1, kernelx)
prewitty = cv2.filter2D(image, -1, kernely)
# Display images
plt.subplot(2,2,1)
plt.imshow(image, cmap='gray')
plt.title("Original Image")
plt.subplot(2,2,2)
plt.imshow(prewittx, cmap='gray')
plt.title("Prewitt X")
plt.subplot(2,2,3)
plt.imshow(prewitty, cmap='gray')
plt.title("Prewitt Y")
plt.show()

""" Roberts edge detection """
kernelx = np.array([[1, 0], [0, -1]])
kernely = np.array([[0, 1], [-1, 0]])
robertsx = cv2.filter2D(image, -1, kernelx)
robertsy = cv2.filter2D(image, -1, kernely)
cv2.imshow('Roberts X', robertsx)
cv2.imshow('Roberts Y', robertsy)
cv2.waitKey(0)
cv2.destroyAllWindows()